# Copy to .env (only if .env does not exist yet). Local synthetic values only — never real credentials.
COMPOSE_PROJECT_NAME=vinabeef

# Host ports (change here if a port is taken)
API_PORT=8080
KEYCLOAK_PORT=8081
RABBITMQ_MGMT_PORT=15672
TOXIPROXY_ADMIN_PORT=8474

# Central PostgreSQL (bootstrap superuser — used only by init scripts)
CENTRAL_DB_SUPERUSER=postgres
CENTRAL_DB_SUPERPASSWORD=change-me-local
CENTRAL_DB_NAME=vinabeef

# Per-service runtime roles (own schema each; no cross-schema access)
HEALTH_DB_USER=health_app
HEALTH_DB_PASSWORD=health-local
IAM_DB_USER=iam_app
IAM_DB_PASSWORD=iam-local
MOVEMENT_DB_USER=movement_app
MOVEMENT_DB_PASSWORD=movement-local
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local

# Keycloak (dev mode only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
OIDC_REALM=vinabeef
# Issuer seen by host / emulator via adb reverse; must equal the token "iss" claim
OIDC_PUBLIC_ISSUER=http://localhost:8081/realms/vinabeef
# Internal route used by containers to fetch signing keys
OIDC_INTERNAL_JWK_SET_URI=http://keycloak:8080/realms/vinabeef/protocol/openid-connect/certs

# Edge (gate profile)
EDGE_DB_SUPERUSER=postgres
EDGE_DB_SUPERPASSWORD=change-me-edge
EDGE_DB_NAME=farm_edge
EDGE_DB_USER=edge_app
EDGE_DB_PASSWORD=edge-local
FARM_ID=FARM-01

# RabbitMQ (gate profile)
RABBITMQ_USER=vinabeef
RABBITMQ_PASSWORD=rabbit-local
RABBITMQ_VHOST=vinabeef
